# Encryption key for pb_data (any random 32+ character string). Required to
# start PocketBase at all — generate one with e.g. `openssl rand -hex 16`.
PB_ENCRYPTION_KEY=

# Superuser account PocketBase creates on first migration
# (pb_migrations/1764579159_create_superuser.js). apps/api authenticates as
# this account too (see apps/api/.env.example) — keep both in sync.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# Booking confirmation, provider notification, provider sign-up alert and
# activation emails all go through Brevo via apps/api now (BREVO_API_KEY
# lives in apps/api/.env.example, not here — see the README section
# "Configurer les emails (Brevo)"). This PocketBase process only sends one
# thing by itself: the standard "mot de passe oublié" reset email, via its
# own SMTP relay (pb_migrations/1789403173_configure_smtp.js) — needs the
# SMTP login/key from Brevo's SMTP & API -> SMTP tab (different credentials
# than the API key used in apps/api). Left unset, that one email just stays
# unsent; nothing else depends on it.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=GlowNyo
