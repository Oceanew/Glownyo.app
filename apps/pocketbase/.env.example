# Encryption key for pb_data (any random 32+ character string). Required to
# start PocketBase at all — generate one with e.g. `openssl rand -hex 16`.
PB_ENCRYPTION_KEY=

# Superuser account PocketBase creates on first migration
# (pb_migrations/1764579159_create_superuser.js). apps/api authenticates as
# this account too (see apps/api/.env.example) — keep both in sync.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# Brevo — powers booking confirmation, provider notification, provider
# sign-up alert and activation emails. See the README section "Configurer
# les emails (Brevo)" for the step-by-step to get these values.
#
# Primary path: Brevo's transactional email API (pb_hooks/brevo-mailer.pb.js).
# Only needs the API key below (SMTP & API -> Clés API on Brevo).
BREVO_API_KEY=

# Alternative path: Brevo's SMTP relay (pb_migrations/1789403173_configure_smtp.js).
# Only used when BREVO_API_KEY above is not set. Needs the SMTP login/key
# from SMTP & API -> SMTP on Brevo (different credentials than the API key).
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# Used by both paths — must be a verified sender or authenticated domain in
# Brevo, otherwise sends are rejected regardless of which path is used.
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=GlowNyo
