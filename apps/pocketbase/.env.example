# Encryption key for pb_data (any random 32+ character string). Required to
# start PocketBase at all — generate one with e.g. `openssl rand -hex 16`.
PB_ENCRYPTION_KEY=

# Superuser account PocketBase creates on first migration
# (pb_migrations/1764579159_create_superuser.js). apps/api authenticates as
# this account too (see apps/api/.env.example) — keep both in sync.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# Brevo SMTP relay — powers booking confirmation, provider notification,
# provider sign-up alert and activation emails
# (pb_migrations/1789403173_configure_smtp.js). See the README section
# "Configurer les emails (Brevo)" for the step-by-step to get these values.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=GlowNyo
