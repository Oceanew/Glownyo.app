# Base URL of the PocketBase API. Defaults to "/hcgi/platform" (current
# hosting's reverse-proxy path) when unset — only set this for a standalone
# deployment where PocketBase lives on its own domain.
# VITE_POCKETBASE_URL=https://pb.glownyo.app

# Base URL of the Express API (apps/api). Defaults to "/hcgi/api" (current
# hosting's reverse-proxy path) when unset — only set this for a standalone
# deployment where the API lives on its own domain.
# VITE_API_URL=https://api.glownyo.app
