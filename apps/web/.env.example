# Base URL of the PocketBase instance. Defaults to "/hcgi/platform" (current
# hosting's reverse-proxy path) when unset — set this for a standalone
# deployment such as PocketBase Cloud (e.g. https://api.glownyo.app or a
# glownyo.pocketbasecloud.com address).
# VITE_POCKETBASE_URL=https://api.glownyo.app

# Base URL for the bookings/providers/reviews/FedaPay/email routes. These are
# registered directly on the PocketBase instance (apps/pocketbase/pb_hooks/api-*.pb.js),
# so this defaults to VITE_POCKETBASE_URL above — only set VITE_API_URL if
# those routes still run on a separate standalone Express server.
# VITE_API_URL=https://api.glownyo.app
