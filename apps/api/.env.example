PORT=3001

# Origin(s) allowed to call this API. CORS is denied by default when unset.
CORS_ORIGIN=

# PocketBase instance this API talks to.
POCKETBASE_URL=http://localhost:8090

# PocketBase superuser credentials used by the server-to-server client
# (apps/api/src/utils/pocketbaseClient.js) and by the admin migration that
# creates the initial superuser (apps/pocketbase/pb_migrations).
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# FedaPay (Mobile Money payment) API credentials.
FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=sandbox

# Brevo transactional email API key (SMTP & API -> Clés API on Brevo — a
# different credential than an SMTP login/key). Powers booking confirmation,
# provider notification and activation emails (apps/api/src/utils/brevo.js).
# See the README section "Configurer les emails (Brevo)".
BREVO_API_KEY=

# Public domain of the deployed site (no trailing slash, scheme optional —
# e.g. "glownyo.app"), used to build the login link in the "provider access
# activated" email sent to an existing client account. Falls back to a
# relative "/connexion" link when unset.
WEBSITE_DOMAIN=
